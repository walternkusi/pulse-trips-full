# =============================================================================
# Pulse Trips API configuration. Copy to .env and fill in.
# Every service works in DEMO mode when its key is empty.
# =============================================================================

# --- Server ---
PORT=4000
# Website origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Public website URL used in emails, QR codes and payment redirects
SITE_URL=http://localhost:3000
# Public URL of this API (links to uploaded tour photos)
API_PUBLIC_URL=http://localhost:4000

# --- Admin dashboard (/admin): use a long random string ---
ADMIN_TOKEN=change-this-to-a-long-random-string

# --- Real photo search in the admin tour editor (free: unsplash.com/developers) ---
UNSPLASH_ACCESS_KEY=

# --- Database: MongoDB Atlas (https://cloud.mongodb.com) ---
# Paste the connection string from Atlas -> Connect -> Drivers.
# Empty = in-memory demo mode (bookings are lost when the server restarts).
MONGODB_URI=
# Database name inside the cluster (created automatically)
MONGODB_DB=pulse_trips

# --- Payments: Stripe (cards, Apple Pay, Google Pay) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: MTN MoMo pay code (guests scan your QR, you confirm in /admin) ---
MOMO_PAY_CODE=2056323
# Minutes the seats are held while the guest pays
MOMO_HOLD_MINUTES=120

# --- Payments: Flutterwave (M-Pesa, MTN MoMo, Airtel Money) ---
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# --- Email (Resend) ---
EMAIL_API_KEY=
EMAIL_FROM=Pulse Trips <bookings@yourdomain.com>
TEAM_EMAIL=

# --- SMS (Twilio) ---
# --- SMS: Africa's Talking (works in Rwanda; username 'sandbox' sends nothing real) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- SMS alternative: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Booking rules ---
# Minutes unpaid bookings hold their seats (minimum 35 is enforced for Stripe)
HOLD_MINUTES=35
