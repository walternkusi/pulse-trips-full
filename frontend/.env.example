# =============================================================================
# Pulse Trips website configuration. Copy to .env.local and fill in.
# NEXT_PUBLIC_ values are visible in the browser: never put secrets here.
# =============================================================================

# Where the backend API runs (see ../backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Public URL of this website (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Communication ---
# WhatsApp number in international format, digits only (e.g. 254700000000)
NEXT_PUBLIC_WHATSAPP=250790631111
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
# Optional live chat agent (https://crisp.chat): website ID
NEXT_PUBLIC_CRISP_ID=

# --- Analytics: Google Analytics 4 measurement ID (G-XXXXXXX) ---
NEXT_PUBLIC_GA_ID=

# --- Social proof: links to your external review profiles ---
NEXT_PUBLIC_TRIPADVISOR_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
